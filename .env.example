# ── Supabase (públicas: podem ir ao navegador) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ── Supabase (SECRETA — somente servidor: webhook, fila, prévias) ──
SUPABASE_SECRET_KEY=

APP_URL=http://localhost:3000

# ── Descoberta e auditoria (somente servidor) ──
GOOGLE_PLACES_API_KEY=
# Custo estimado por requisição Text Search, em centavos de real, para o painel de custos.
PLACES_COST_CENTS_PER_REQUEST=20
BRAVE_SEARCH_API_KEY=

# ── IA (opcional; sem ela usa o modelo de mensagem aprovado) — Anthropic Messages API ──
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# ── WhatsApp Cloud API (somente servidor; envio desabilitado por padrão no workspace) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Protege /api/cron/* (worker da fila e retenção). Envie como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
